{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto connect Android Emulator",
            "type": "process",
            "command": "bash",
            "args": [
                "-lc",
                "nohup \"$HOME/bin/android-connect-wait\" 180 >> \"$HOME/.android-connect.log\" 2>&1 </dev/null &"
            ],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "never",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
